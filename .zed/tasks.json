// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
//
// Example:
[
  {
    "label": "Run C++ Program",
    "command": "g++ -std=c++23 \"$ZED_FILE\" -o \"$ZED_DIRNAME/$ZED_STEM.exe\"; if($?) { & \"$ZED_DIRNAME/$ZED_STEM.exe\" }; if($?) { & Remove-Item -Path \"$ZED_DIRNAME/$ZED_STEM.exe\" }",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "reveal_target": "dock",
    "hide": "never",
    "shell": "system",
    "show_summary": true,
    "show_command": true,
    "save": "none",
  },
]
